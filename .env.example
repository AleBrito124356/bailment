# bailment configuration.
#
# Copy to .env and edit. Every value below is also settable as an environment variable of
# the same name, which is what a container deployment should do -- .env is for a laptop.
#
# EVERY VALUE IN THIS FILE IS FAKE. The placeholders are deliberately shaped so they can
# never be mistaken for a live credential: anything ending in _REPLACE_ME is not a secret,
# it is a hole. Do not commit a filled-in copy of this file; .gitignore already refuses
# .env for you.
#
# Anything bailment does not recognise is ignored and then reported at warning level on
# startup. A misspelled credential -- BAILMENT_NEON_KEY, note the missing _API -- otherwise
# surfaces as "provider unavailable" and nothing else, which costs somebody an afternoon.


# ======================================================================================
# Secrets
# ======================================================================================

# The Fernet key protecting every binding at rest. 32 bytes, url-safe base64, 44 characters.
#
#   bailment keygen
#
# There is no default and bailment will not invent one. A key that appears by itself is a
# key that changes on restart, and every binding written before that restart becomes
# permanently unreadable -- silently, and you find out during the incident rather than
# before it. Absent is legal at import time (so `bailment keygen` can run on a machine that
# has no key yet) and fatal the first time anything seals or opens a binding.
BAILMENT_ENCRYPTION_KEY=fernet_key_REPLACE_ME_run_bailment_keygen=

# Retired keys, comma-separated, newest first. Used for decryption only.
#
# This is how rotation works: generate a new key, move the current value here, restart. Old
# bindings still open, new ones are sealed with the new key, and once nothing sealed with an
# old key is still live you delete it from this line. Rotating by replacement instead
# strands every live binding.
BAILMENT_PREVIOUS_ENCRYPTION_KEYS=

# Permit the demo key that docker-compose.yml ships as its default.
#
# That key is real, works, and is published in this repository, so anything sealed with it
# can be opened by anyone who has read the repository. bailment therefore refuses to start
# when it sees that specific key unless this is true, and the shipped compose file is the
# only place that sets it. Leave this alone. If you hit the error, the fix is `bailment
# keygen`, not this line.
BAILMENT_ALLOW_DEMO_KEY=false


# ======================================================================================
# Storage
# ======================================================================================

# Async SQLAlchemy URL. SQLite by default so that cloning the repo and running the sandbox
# path needs no database at all.
#
# Use Postgres for anything with more than one worker process:
#   postgresql+asyncpg://bailment:password@localhost:5432/bailment
BAILMENT_DATABASE_URL=sqlite+aiosqlite:///./bailment.db

# Echo every SQL statement to the log. Extremely noisy; genuinely useful when a worker claim
# query is misbehaving and you need to see the conditional update that did not match.
BAILMENT_DB_ECHO=false


# ======================================================================================
# Identity and authentication
# ======================================================================================

# Comma-separated principal:token pairs that may request and read leases. Agent tier.
#
# The principal lands in Lease.requester and in every audit row, so name them for what they
# are: 'claude-code-alice', 'ci-integration-tests'. A bare token with no principal is
# accepted and labelled by a hash of itself, which is legible to nobody.
#
# Split on the FIRST colon, so a token may itself contain colons.
BAILMENT_API_TOKENS=agent-local:agent_token_REPLACE_ME,ci:ci_token_REPLACE_ME

# Comma-separated principal:token pairs that may additionally approve, reject, revoke
# anyone's lease, re-drive a stuck teardown and read binding values over the OSB surface.
# Operator tier. Admin implies everything an api token can do.
#
# Hold these to humans. An approval gate that an automated principal can open is not a gate.
BAILMENT_ADMIN_TOKENS=alice:operator_token_REPLACE_ME

# Accept unauthenticated requests as the principal 'anonymous', at AGENT tier and never
# higher. For the local demo only.
#
# It is a separate switch rather than "no tokens configured means open", precisely because
# that implicit rule is how open brokers happen.
BAILMENT_ALLOW_ANONYMOUS=false


# ======================================================================================
# Catalog
# ======================================================================================

# Directory of golden path YAML files. Defaults to the four paths shipped inside the
# package (sandbox, postgres, redis, dns-record). Mount your own over it in production:
#   BAILMENT_CATALOG_DIR=/etc/bailment/paths
#
# Left blank here so the shipped default applies. Validate before shipping any change:
#   bailment catalog validate --strict
BAILMENT_CATALOG_DIR=


# ======================================================================================
# Serving
# ======================================================================================

# Bind address. 127.0.0.1 on a laptop; containers must set 0.0.0.0 or nothing outside the
# container can reach them.
BAILMENT_HOST=127.0.0.1
BAILMENT_PORT=8080

# How a human reaches the dashboard from outside the container. Two things read this: the
# approval links written into notices, which are worthless if they point at 127.0.0.1, and
# the CORS allow-list, which is this one origin and not a wildcard -- an approval that any
# origin can drive out of a logged-in operator's browser is not an approval.
BAILMENT_PUBLIC_BASE_URL=http://localhost:8080


# ======================================================================================
# Engine timing
# ======================================================================================

# How often the lease engine looks for leases to warn about, expire or tear down.
#
# This is the resolution of the entire TTL promise. A five-minute sandbox lease with a
# sixty-second tick can outlive its deadline by a minute, and that gap is the honest measure
# of what "the lease expires" is worth in your deployment.
BAILMENT_LEASE_TICK_SECONDS=15

# How often the reconciler compares provider reality against the lease table.
BAILMENT_RECONCILE_INTERVAL_SECONDS=300
BAILMENT_RECONCILE_ENABLED=true

# Whether the reconciler may destroy a resource it believes is orphaned.
#
# Off by default, and leave it off until you trust the tagging in your account. Finding
# orphans is safe; deleting something a human created by hand outside bailment is not. Even
# with this on, destroying also requires a per-provider allowlist, so no single
# misconfiguration can start deleting things.
BAILMENT_RECONCILE_AUTO_DESTROY_ORPHANS=false

# Default httpx timeout, in seconds, for every provider call. There is no unbounded call
# anywhere in this system.
BAILMENT_PROVIDER_TIMEOUT_SECONDS=20.0

# Attempts before a provision or a teardown stops retrying and surfaces -- as FAILED for a
# provision, as ORPHANED for a teardown. Orphans are not retried automatically afterwards:
# a loop that keeps calling a provider that keeps refusing hides the problem instead of
# showing it. A human says try again with `bailment lease retry-teardown`.
BAILMENT_MAX_PROVISION_ATTEMPTS=5

# Written into Lease.claimed_by. Must be unique per process; the default is hostname-pid,
# which is. Two processes sharing an id will steal each other's in-flight work.
# Leave unset unless you have a reason.
# BAILMENT_WORKER_ID=


# ======================================================================================
# Logging
# ======================================================================================

# debug, info, warning, error or critical.
BAILMENT_LOG_LEVEL=info

# json for anything that ships logs somewhere, console for a human at a terminal.
BAILMENT_LOG_FORMAT=json


# ======================================================================================
# Provider credentials -- all optional
# ======================================================================================
#
# A missing credential makes that provider *unavailable*, which the dashboard shows, the
# MCP catalog reflects and `bailment providers` explains. It is never a startup crash: the
# sandbox golden path exists precisely so somebody with no cloud accounts at all can run
# the whole system end to end.
#
# Scope every one of these as narrowly as the provider permits.

# --- Neon (golden path: postgres) -----------------------------------------------------
# A personal or project-scoped API key from https://console.neon.tech/app/settings/api-keys
# and the project whose branches this installation is allowed to create.
BAILMENT_NEON_API_KEY=neon_api_key_REPLACE_ME
BAILMENT_NEON_PROJECT_ID=neon_project_id_REPLACE_ME

# --- Upstash (golden path: redis) -----------------------------------------------------
# The management API is authenticated with the account email plus a management API key,
# from https://console.upstash.com/account/api
BAILMENT_UPSTASH_EMAIL=you_REPLACE_ME@example.com
BAILMENT_UPSTASH_API_KEY=upstash_api_key_REPLACE_ME

# --- Cloudflare (golden path: dns-record) ---------------------------------------------
# A scoped API token with Zone:DNS:Edit on exactly the zone below -- not a Global API Key,
# which is account-wide and cannot be scoped at all.
BAILMENT_CLOUDFLARE_API_TOKEN=cloudflare_api_token_REPLACE_ME
BAILMENT_CLOUDFLARE_ZONE_ID=cloudflare_zone_id_REPLACE_ME


# ======================================================================================
# Resource marker
# ======================================================================================

# The prefix every bailment-managed resource carries, and the filter the reconciler uses to
# decide what it is allowed to touch. Defaults to 'bailment-'.
#
# Set it if two bailment installations share one cloud account, so they do not reconcile
# each other's resources into oblivion.
#
# Note: this one is read directly by the provider layer rather than through Settings, so it
# currently also shows up in the "unrecognised BAILMENT_* variable" warning on startup. The
# value is still applied. See src/bailment/providers/base.py:resource_prefix.
# BAILMENT_RESOURCE_PREFIX=bailment-
