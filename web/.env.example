# Where the broker's REST API lives. The browser calls this directly, so it has to be
# reachable from the operator's machine, not just from the Next server.
#
# The dashboard appends /api/v1 itself -- give it the origin only.
NEXT_PUBLIC_BAILMENT_API=http://127.0.0.1:8000

# There is no BAILMENT_API_TOKEN here, and that is not an omission.
#
# A token in this file would be baked into the Next process and used for every visitor,
# which turns "who is allowed to approve a production database branch" into "who can open
# a URL". The dashboard asks the operator for a token in the browser and keeps it in
# sessionStorage for that tab only. See src/lib/auth.ts.
